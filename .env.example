# Environment Configuration for CloudPulse

# Flask Application
FLASK_APP=backend.app.main:app
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0
SECRET_KEY=cloudpulse-super-secret-dev-key-change-in-production
API_KEY=cloudpulse-internal-api-key-2026

# Database
# Local SQLite by default; use postgresql://user:pass@localhost:5432/cloudpulse in production
DATABASE_URL=sqlite:///c:/Users/theju/OneDrive/Desktop/CLOUDPULSE/data/cloudpulse.db

# Monitoring Thresholds
THRESHOLD_CPU_WARNING=75.0
THRESHOLD_CPU_CRITICAL=90.0
THRESHOLD_MEMORY_WARNING=80.0
THRESHOLD_MEMORY_CRITICAL=92.0
THRESHOLD_DISK_WARNING=80.0
THRESHOLD_DISK_CRITICAL=90.0
METRIC_COLLECTION_INTERVAL_SECONDS=10

# Automated Remediation Security
REMEDIATION_ENABLED=true
REMEDIATION_REQUIRE_APPROVAL=true
REMEDIATION_ALLOWED_SERVICES=nginx,apache2,postgresql,redis,cloudpulse-worker,test-service
REMEDIATION_ALLOWED_TEMP_PATHS=/tmp/cloudpulse_test,/tmp/cloudpulse_cache,./data/test_temp

# AWS Integration (Optional - falls back to Local / Simulation mode if omitted)
AWS_REGION=us-east-1
ENABLE_AWS_INTEGRATION=false
AWS_CLOUDWATCH_NAMESPACE=CloudPulse/Infrastructure
AWS_SNS_INCIDENT_TOPIC_ARN=
